{
  "manifest_version": 3,
  "name": "Goofish Br - Seus achados",
  "version": "1.3.1",
  "description": "Explore anúncios do catálogo Goofish Br sem login, veja preços em reais, organize achados e abra links para agentes.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "optional_permissions": [
    "notifications"
  ],
  "optional_host_permissions": [
    "https://*.workers.dev/*",
    "https://open.er-api.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Goofish Br",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "host_permissions": [
    "https://www.goofish.com/*",
    "https://goofish.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.goofish.com/*",
        "https://goofish.com/*"
      ],
      "js": [
        "overlay.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html"
      ],
      "matches": [
        "https://www.goofish.com/*",
        "https://goofish.com/*"
      ]
    }
  ]
}
