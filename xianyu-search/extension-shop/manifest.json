{
  "manifest_version": 3,
  "name": "Goofish Br — Seus achados",
  "version": "1.1.0",
  "description": "Pesquise no Goofish Br, converta preços, organize anúncios e fornecedores e copie produtos para seu agente.",
  "permissions": ["activeTab", "scripting", "storage", "alarms"],
  "optional_permissions": ["notifications"],
  "optional_host_permissions": ["https://*.workers.dev/*", "https://open.er-api.com/*"],
  "background": {"service_worker":"background.js"},
  "action": {"default_popup": "popup.html", "default_title": "Goofish Br", "default_icon": {"16":"icons/16.png","48":"icons/48.png","128":"icons/128.png"}},
  "icons": {"16":"icons/16.png","48":"icons/48.png","128":"icons/128.png"},
  "content_security_policy": {"extension_pages":"script-src 'self'; object-src 'none'"}
}
