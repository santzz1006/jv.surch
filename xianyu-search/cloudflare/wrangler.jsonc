{
  "name": "goofish-br-api",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "goofish-br",
      "database_id": "SUBSTITUA_PELO_ID_DO_D1",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "0 */6 * * *"
    ]
  },
  "vars": {
    "ALERT_BATCH": "10"
  }
}
