do local p=server;local s=p:FindFirstChild("Combat") or Instance.new("ModuleScript");s.Name="Combat";s.Source=[====[-- Logical projectiles stay server-owned; clients render their replicated positions.
local RS=game:GetService("RunService")
local C=require(game.ReplicatedStorage.PaddleBrawl.Config)
